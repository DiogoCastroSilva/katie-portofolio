# Copy to apps/main/.env.local for local overrides (optional).

# GitHub Pages project site (repo is not <user>.github.io).
# Example: NEXT_PUBLIC_BASE_PATH=/my-portfolio
# Leave unset for local dev (site served at http://localhost:3000).
# NEXT_PUBLIC_BASE_PATH=

# Canonical public URL (CI sets this automatically on GitHub Actions).
# NEXT_PUBLIC_DEPLOYMENT_URL=https://your-user.github.io/your-repo

# Cloudflare Web Analytics (optional — defaults in site-config.ts if unset).
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_DISABLED=true
